{
  "schemaVersion": 1,
  "rules": [
    {
      "path": "Directory.Build.props",
      "search": "<RootNamespaceBase>{{SOURCE_PREFIX}}</RootNamespaceBase>",
      "replace": "<RootNamespaceBase>{{FRAMEWORK_PREFIX}}</RootNamespaceBase>"
    },
    {
      "path": "Directory.Build.props",
      "search": "<Product>{{SOURCE_PREFIX}}</Product>",
      "replace": "<Product>{{FRAMEWORK_NAME}}</Product>"
    },
    {
      "path": "Directory.Build.props",
      "search": "<RepositoryUrl>https://github.com/{{SOURCE_REPO}}</RepositoryUrl>",
      "replace": "<RepositoryUrl>https://github.com/{{TARGET_REPO}}</RepositoryUrl>"
    },
    {
      "path": "scripts/lib/dotnet-env.sh",
      "search": "{{SOURCE_PREFIX_UPPER}}_",
      "replace": "FRAMEWORK_"
    },
    {
      "path": "scripts/lib/dotnet-env.sh",
      "search": "{{SOURCE_PREFIX_LOWER}}_",
      "replace": "framework_"
    },
    {
      "path": "tools/tests/test_dotnet_env.py",
      "search": "{{SOURCE_PREFIX_UPPER}}_",
      "replace": "FRAMEWORK_"
    },
    {
      "path": "tools/tests/test_dotnet_env.py",
      "search": "{{SOURCE_PREFIX_LOWER}}-",
      "replace": "framework-"
    },
    {
      "path": "scripts/doctor.sh",
      "search": "{{SOURCE_PREFIX_LOWER}}_primary_checkout_root",
      "replace": "framework_primary_checkout_root"
    },
    {
      "path": "scripts/doctor.sh",
      "search": "{{SOURCE_PREFIX_UPPER}}_DOTNET_SOURCE",
      "replace": "FRAMEWORK_DOTNET_SOURCE"
    },
    {
      "path": "scripts/doctor.sh",
      "search": "{{SOURCE_PREFIX_UPPER}}_DOTNET_HOME",
      "replace": "FRAMEWORK_DOTNET_HOME"
    },
    {
      "path": "scripts/bootstrap-dotnet.sh",
      "search": "{{SOURCE_PREFIX_LOWER}}_primary_checkout_root",
      "replace": "framework_primary_checkout_root"
    },
    {
      "path": "scripts/bootstrap-dotnet.sh",
      "search": "{{SOURCE_PREFIX}}'s `dotnet`",
      "replace": "this framework's `dotnet`"
    },
    {
      "path": "tools/dispatch-agent.sh",
      "search": "{{SOURCE_PREFIX_UPPER}}_WORKTREE_ROOT",
      "replace": "FRAMEWORK_WORKTREE_ROOT"
    },
    {
      "path": "tools/dispatch-agent.sh",
      "search": "{{SOURCE_PREFIX_LOWER}}-worktrees",
      "replace": "${REPO_NAME}-worktrees"
    },
    {
      "path": "tools/dispatch-agent.sh",
      "search": "cd \"$REPO_ROOT\"\n\nWORKTREE_ROOT=",
      "replace": "cd \"$REPO_ROOT\"\n\nREPO_NAME=\"$(basename \"$REPO_ROOT\")\"\nWORKTREE_ROOT="
    },
    {
      "path": "tools/dispatch-agent.sh",
      "search": "Escalate to Brandon",
      "replace": "Escalate to the orchestrator"
    },
    {
      "path": "tools/tests/test_dispatch_agent.py",
      "search": "{{SOURCE_PREFIX_UPPER}}_WORKTREE_ROOT",
      "replace": "FRAMEWORK_WORKTREE_ROOT"
    },
    {
      "path": "tools/tests/test_dispatch_agent.py",
      "search": "{{SOURCE_PREFIX_LOWER}}-dispatch-",
      "replace": "framework-dispatch-"
    },
    {
      "path": "tools/tests/test_dispatch_agent.py",
      "search": "rather than to {{SOURCE_PREFIX}} itself.",
      "replace": "rather than to the framework repository itself."
    },
    {
      "path": ".claude/hooks/primary-checkout-guard.py",
      "search": "{{SOURCE_PREFIX_UPPER}}_",
      "replace": "FRAMEWORK_"
    },
    {
      "path": ".claude/hooks/primary-checkout-guard.py",
      "search": "clean step. Use tools/dispatch-agent.sh, or set FRAMEWORK_WORKTREE_ROOT\\n",
      "replace": "clean step. Use tools/dispatch-agent.sh. If its default location is unsuitable,\\n"
    },
    {
      "path": ".claude/hooks/primary-checkout-guard.py",
      "search": "to a directory outside the repo.",
      "replace": "set FRAMEWORK_WORKTREE_ROOT to a directory outside the repo."
    },
    {
      "path": "tools/tests/test_primary_checkout_guard.py",
      "search": "{{SOURCE_PREFIX_UPPER}}_",
      "replace": "FRAMEWORK_"
    },
    {
      "path": "tools/tests/test_primary_checkout_guard.py",
      "search": "{{SOURCE_PREFIX_LOWER}}-guard-",
      "replace": "framework-guard-"
    }
  ]
}
