# Deterministic, platform-independent text handling. LF everywhere, no CRLF conversion.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary-ish: never diff, never normalize.
*.pdf       binary
*.png       binary
*.jpg       binary
*.zip       binary
